<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: adb control surface for emulator/device testing, and plain ws:// to a local `wrangler dev`. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="net.littlesavage.homevoice.debug.CONFIG" />
                <action android:name="net.littlesavage.homevoice.debug.SAY" />
                <action android:name="net.littlesavage.homevoice.debug.INJECT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
