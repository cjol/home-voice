{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "home-voice-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "39f3f1b5073547672a0d7ad67319df81",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "VoiceAgent", "class_name": "VoiceAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceAgent"] }],
  "vars": {
    // Benchmark winner: only Workers AI model to answer all 4 Executor test questions (4-16 s).
    // Must support real tool calls; see NON_TOOL_MODELS in src/llm.ts for known-bad ones.
    "LLM_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "TTS_VOICE": "luna",
    "EXECUTOR_MCP_URL": "https://mcp.executor.sh/mcp"
    // PUBLIC_URL (OAuth callback host) is derived from the request if unset.
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): DEVICE_TOKEN
}
